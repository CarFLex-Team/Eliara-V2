# Copy to .env and fill in. Never commit .env — it's gitignored.
# Every value below is either a safe default (matching app/core/config.py)
# or an empty placeholder you must fill in. Nothing here is a real secret.

# --- Runtime ---
ELIARA_ENVIRONMENT=dev
ELIARA_LOG_LEVEL=INFO

# --- Multi-company registry ---
# Maps company_id -> db path, scan views, playbooks/prompts dirs. See
# companies.yaml and MULTI_COMPANY_DESIGN.md for the full design.
ELIARA_COMPANIES_CONFIG=companies.yaml
# Used by the legacy root-mounted POST /ask endpoint when the caller sends
# no company_id, so an old frontend integration keeps working unmodified.
ELIARA_DEFAULT_COMPANY_ID=beta

# --- Database (legacy single-company fallback only) ---
# Company-scoped requests always resolve their db path from companies.yaml,
# never from here. This remains only as a fallback for a test/tool that
# constructs a ReadOnlyExecutor directly without going through
# CompanyContextManager.
ELIARA_DB_PATH=data/eliara_production_clean.db
ELIARA_DB_WATCH_INTERVAL_S=60
ELIARA_QUERY_TIMEOUT_S=30
ELIARA_MAX_ROWS=500

# --- LLM ---
ELIARA_ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ELIARA_ORCHESTRATOR_MODEL=claude-sonnet-4-6
ELIARA_SQLGEN_MODEL=claude-haiku-4-5-20251001
ELIARA_LLM_TIMEOUT_S=40
ELIARA_LLM_MAX_RETRIES=2
ELIARA_REQUEST_DEADLINE_S=75

# --- Discovery (embeddings + retrieval) ---
# bge | hashing | none. Use "hashing" for tests/CI (no model download).
ELIARA_EMBEDDING_BACKEND=bge
ELIARA_EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
ELIARA_EMBEDDING_CACHE_DIR=data/cache
ELIARA_TOP_K_VIEWS=8
ELIARA_ENTITY_INDEX_INCLUDE_FACTS=false
ELIARA_ENTITY_INDEX_SOURCES=

# --- Conversation ---
ELIARA_HISTORY_SIZE=5
ELIARA_SESSION_TTL_MIN=120

# --- API ---
ELIARA_MAX_MESSAGE_CHARS=2000
ELIARA_CHAT_RATE_LIMIT_PER_MIN=20
# Comma-separated origins, or "*" (safe here — no cookies cross-origin).
ELIARA_CORS_ORIGINS=*
# Mounts the legacy root-level POST /ask + GET /health for the old frontend.
ELIARA_LEGACY_API_ENABLED=true
# Optional X-API-Key guard for /v1/query. Leave empty to disable.
ELIARA_LEGACY_API_KEY=
ELIARA_ASK_SHARED_SECRET=

# --- Audit trail ---
ELIARA_AUDIT_ENABLED=true
ELIARA_AUDIT_DIR=audit

# --- Playbooks ---
ELIARA_PLAYBOOKS_ENABLED=true

# --- Answer shape ---
ELIARA_ANSWER_CHAR_BUDGET=1200
ELIARA_ANSWER_MAX_BULLETS=5
ELIARA_VERIFICATION_STRICT=false

# --- Result cache / payload budget ---
ELIARA_RESULT_CACHE_TTL_S=600
ELIARA_PAYLOAD_MAX_CHARS=6000

# --- Reasoning agent (prototype; off by default) ---
# Powers /investigate and causal "why did X happen" routing. Off by
# default — several past production incidents traced back to this being
# expected-on but actually off. Confirm intentionally before enabling.
ELIARA_AGENT_ENABLED=false
ELIARA_AGENT_MAX_STEPS=4
ELIARA_AGENT_TIME_BUDGET_S=55
ELIARA_AGENT_TOKEN_BUDGET=60000

# --- External knowledge (/search prefix; off by default) ---
ELIARA_EXTERNAL_ENABLED=false
ELIARA_EXTERNAL_PREFIX=/search
ELIARA_EXTERNAL_WEB_SEARCH=true
ELIARA_EXTERNAL_MAX_SEARCHES=5

# --- Explicit investigate access (bypasses routing entirely) ---
ELIARA_INVESTIGATE_PREFIX=/investigate

# --- Proactive attention scan (bypasses routing, no view name required) ---
ELIARA_SCAN_ENABLED=false
ELIARA_SCAN_PREFIX=/scan
ELIARA_SCAN_MAX_ITEMS_PER_VIEW=5
